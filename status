#!/usr/bin/env python3
"""Scan Omarchy plugin checkouts and recorded customizations.

Prints one JSON object. Optional flags:
  --bootstrap           write draft records for unrecorded local diffs
  --fetch               git fetch origin on git-managed plugins
  --notify              desktop-notify on a false→true attention transition
  --reset PLUGIN_ID     restore checkout to HEAD/clone source; mark records unapplied
  --update PLUGIN_ID    fetch and reset to origin (or clone source); mark unapplied
  --delete PLUGIN_ID CUSTOMIZATION_ID
                        unapplied/draft: remove the markdown.
                        enabled: reset the checkout, then remove the markdown.
"""
from __future__ import annotations

import argparse
import fcntl
import hashlib
import json
import os
import re
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path

SELF_ID = "djschnei21.plugin-maleability"
PLUGINS_DIR = Path.home() / ".config/omarchy/plugins"
RECORDS_DIR = Path.home() / ".config/omarchy/plugin-maleability"
NOTIFY_STATE = RECORDS_DIR / ".notify-state"
LOCK_PATH = RECORDS_DIR / ".lock"
SELF_DIR = Path(__file__).resolve().parent
MAX_DIFF = 8000


def run(cmd, cwd=None, timeout=20):
    env = os.environ.copy()
    env["GIT_TERMINAL_PROMPT"] = "0"
    env["GIT_SSH_COMMAND"] = env.get("GIT_SSH_COMMAND", "ssh -oBatchMode=yes")
    try:
        proc = subprocess.run(
            cmd,
            cwd=cwd,
            env=env,
            capture_output=True,
            text=True,
            timeout=timeout,
        )
        return proc.returncode, proc.stdout, proc.stderr
    except (OSError, subprocess.TimeoutExpired) as exc:
        return 1, "", str(exc)


def git(cwd, *args, timeout=20):
    code, out, err = run(["git", "-C", str(cwd), *args], timeout=timeout)
    return code, out.rstrip("\n"), err.rstrip("\n")


def now_iso():
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def fail_payload(error, **extra):
    payload = {"ok": False, "error": error}
    payload.update(extra)
    json.dump(payload, sys.stdout)
    sys.stdout.write("\n")
    return 1


class records_lock:
    def __enter__(self):
        RECORDS_DIR.mkdir(parents=True, exist_ok=True)
        self.fd = open(LOCK_PATH, "a")
        fcntl.flock(self.fd, fcntl.LOCK_EX)
        return self

    def __exit__(self, exc_type, exc, tb):
        fcntl.flock(self.fd, fcntl.LOCK_UN)
        self.fd.close()
        return False


def read_json(path: Path, default=None):
    try:
        return json.loads(path.read_text())
    except (OSError, json.JSONDecodeError):
        return default


def plugin_manifest(path: Path):
    data = read_json(path / "manifest.json", {}) or {}
    return {
        "id": str(data.get("id") or path.name),
        "name": str(data.get("name") or path.name),
        "version": str(data.get("version") or ""),
        "clonedFrom": str((data.get("omarchy") or {}).get("clonedFrom") or ""),
    }


def catalog_source_dirs():
    code, out, _ = run(["omarchy-plugin-catalog"])
    if code != 0 or not out.strip():
        return {}
    try:
        rows = json.loads(out)
    except json.JSONDecodeError:
        return {}
    mapping = {}
    for row in rows:
        pid = str(row.get("id") or "")
        src = str(row.get("sourceDir") or "")
        if pid and src:
            mapping[pid] = Path(src)
    return mapping


def parse_frontmatter(text: str):
    if not text.startswith("---"):
        return {}, text
    rest = text[3:].lstrip("\n")
    end = rest.find("\n---")
    if end < 0:
        return {}, text
    fm = rest[:end]
    body = rest[end + 4 :]
    lists, maps = set(), set()
    current = None
    for raw in fm.splitlines():
        line = raw.rstrip()
        if not line.strip():
            continue
        if line.startswith("  - "):
            if current:
                lists.add(current)
            continue
        if line.startswith("  ") and ":" in line.strip():
            if current:
                maps.add(current)
            continue
        if ":" in line and not line.startswith(" "):
            current = line.split(":", 1)[0].strip()
    data = {}
    current_list = None
    current_map = None
    for raw in fm.splitlines():
        line = raw.rstrip()
        if not line.strip():
            continue
        if line.startswith("  - ") and current_list is not None:
            current_list.append(line[4:].strip().strip('"'))
            continue
        if line.startswith("  ") and current_map is not None:
            nested = line.strip()
            if ":" in nested:
                k, v = nested.split(":", 1)
                current_map[k.strip()] = v.strip().strip('"')
            continue
        if ":" not in line or line.startswith(" "):
            continue
        key, value = line.split(":", 1)
        key = key.strip()
        value = value.strip()
        current_list = None
        current_map = None
        if value == "":
            if key in lists:
                data[key] = []
                current_list = data[key]
            else:
                data[key] = {}
                current_map = data[key]
            continue
        if value.lower() in ("true", "false"):
            data[key] = value.lower() == "true"
        else:
            data[key] = value.strip('"')
    return data, body


def goal_is_draft(body: str) -> bool:
    text = body.lower()
    return "draft — refine" in text or "draft - refine" in text


def extract_section(body: str, heading: str) -> str:
    match = re.search(r"^##\s+" + re.escape(heading) + r"\s*$", body, re.I | re.M)
    if not match:
        return ""
    rest = body[match.end() :]
    nxt = re.search(r"^##\s+", rest, re.M)
    text = rest[: nxt.start()] if nxt else rest
    return text.strip()


def extract_why(body: str) -> str:
    return extract_section(body, "Why / decisions") or extract_section(body, "Why")


def clip(text: str, limit: int = 700) -> str:
    text = text.strip()
    if len(text) <= limit:
        return text
    return text[: limit - 1].rstrip() + "…"


def tree_hash(plugin_dir: Path, files: list[str]) -> str:
    h = hashlib.sha256()
    for rel in sorted(files):
        h.update(rel.encode())
        h.update(b"\0")
        path = plugin_dir / rel
        if path.is_file():
            h.update(path.read_bytes())
        else:
            h.update(b"-")
        h.update(b"\n")
    return h.hexdigest()[:16]


def source_fingerprint(source: Path | None) -> str:
    if not source or not source.is_dir():
        return ""
    rels = []
    for src in source.rglob("*"):
        if not src.is_file():
            continue
        rel = src.relative_to(source).as_posix()
        if rel == "manifest.json" or rel.startswith(".git/"):
            continue
        rels.append(rel)
    h = hashlib.sha256()
    for rel in sorted(rels):
        h.update(rel.encode())
        h.update(b"\0")
        h.update((source / rel).read_bytes())
        h.update(b"\n")
    return h.hexdigest()[:16]


def load_records():
    records = {}
    if not RECORDS_DIR.is_dir():
        return records
    for plugin_dir in sorted(RECORDS_DIR.iterdir()):
        if not plugin_dir.is_dir() or plugin_dir.name.startswith("."):
            continue
        for path in sorted(plugin_dir.glob("*.md")):
            text = path.read_text(errors="replace")
            fm, body = parse_frontmatter(text)
            pid = str(fm.get("plugin") or plugin_dir.name)
            cid = str(fm.get("id") or path.stem)
            applied = fm.get("applied") if isinstance(fm.get("applied"), dict) else {}
            files = fm.get("files") if isinstance(fm.get("files"), list) else []
            if "enabled" in fm:
                enabled = bool(fm.get("enabled"))
            else:
                enabled = True
            rec = {
                "id": cid,
                "plugin": pid,
                "title": str(fm.get("title") or cid),
                "bootstrapped": bool(fm.get("bootstrapped")),
                "enabled": enabled,
                "appliedCommit": str(applied.get("commit") or ""),
                "appliedAt": str(applied.get("at") or ""),
                "appliedVersion": str(applied.get("version") or ""),
                "appliedSource": str(applied.get("source") or ""),
                "appliedTree": str(applied.get("tree") or ""),
                "files": [str(f) for f in files],
                "path": str(path),
                "draftGoal": goal_is_draft(body),
                "goal": clip(extract_section(body, "Goal")),
                "why": clip(extract_why(body), 400),
            }
            records.setdefault(pid, []).append(rec)
    return records


def git_head(path: Path) -> str:
    code, out, _ = git(path, "rev-parse", "HEAD")
    return out if code == 0 else ""


def git_origin(path: Path) -> str:
    for ref in ("@{u}", "origin/HEAD", "origin/main", "origin/master"):
        code, out, _ = git(path, "rev-parse", ref)
        if code == 0 and out:
            return out
    return ""


def git_dirty_files(path: Path) -> list[str]:
    code, out, _ = git(path, "status", "--porcelain", "-uall")
    if code != 0 or not out:
        return []
    files = []
    for line in out.splitlines():
        entry = line[3:] if len(line) > 3 else line
        if " -> " in entry:
            entry = entry.split(" -> ", 1)[1]
        entry = entry.strip().strip('"')
        if entry:
            files.append(entry)
    return files


def git_untracked_files(path: Path) -> list[str]:
    code, out, _ = git(path, "status", "--porcelain", "-uall")
    if code != 0 or not out:
        return []
    files = []
    for line in out.splitlines():
        if line.startswith("??"):
            entry = line[3:].strip().strip('"')
            if entry:
                files.append(entry)
    return files


def clip_diff(text: str) -> str:
    if len(text) > MAX_DIFF:
        return text[:MAX_DIFF] + "\n… (truncated)\n"
    return text


def new_file_diff(path: Path) -> str:
    if not path.is_file():
        return f"--- {path.name} (presence changed)\n"
    code, out, _ = run(["diff", "-u", "/dev/null", str(path)])
    return out or f"--- {path.name} (presence changed)\n"


def removed_file_diff(path: Path, rel: str) -> str:
    if not path.is_file():
        return f"--- {rel} (presence changed)\n"
    code, out, _ = run(["diff", "-u", str(path), "/dev/null"])
    return out or f"--- {rel} (presence changed)\n"


def git_diff_text(path: Path) -> str:
    chunks = []
    code, out, _ = git(path, "diff", "HEAD")
    if code == 0 and out:
        chunks.append(out)
    code, out, _ = git(path, "diff", "--cached")
    if code == 0 and out:
        chunks.append(out)
    for rel in git_untracked_files(path):
        chunks.append(new_file_diff(path / rel))
    if not chunks:
        code, out, _ = git(path, "diff", "--stat", "HEAD")
        return clip_diff(out if code == 0 else "")
    return clip_diff("\n\n".join(chunks))


def git_ahead_diff(path: Path, origin: str) -> str:
    if not origin:
        return ""
    code, out, _ = git(path, "diff", f"{origin}...HEAD")
    if code != 0:
        return ""
    return clip_diff(out)


def clone_diff_files(path: Path, source: Path) -> list[str]:
    if not source.is_dir():
        return []
    _, out, _ = run(["diff", "-rq", str(source), str(path)])
    files = []
    prefix = str(path) + "/"
    only_in_clone = "Only in " + str(path)
    only_in_source = "Only in " + str(source)
    for line in (out or "").splitlines():
        if line.startswith("Files ") and " and " in line:
            rest = line.split("Files ", 1)[1]
            right = rest.split(" and ", 1)[1].split(" differ", 1)[0]
            if right.startswith(prefix):
                files.append(right[len(prefix) :])
        elif line.startswith(only_in_clone):
            loc = line[len("Only in ") :]
            folder, name = loc.split(": ", 1)
            rel = str(Path(folder).relative_to(path) / name) if folder != str(path) else name
            files.append(rel)
        elif line.startswith(only_in_source):
            loc = line[len("Only in ") :]
            folder, name = loc.split(": ", 1)
            rel = str(Path(folder).relative_to(source) / name) if folder != str(source) else name
            files.append(rel)
    return [f for f in files if f != ".git" and not f.startswith(".git/") and f != "manifest.json"]


def clone_diff_text(path: Path, source: Path, files: list[str]) -> str:
    chunks = []
    for rel in files:
        if rel == "manifest.json":
            continue
        left = source / rel
        right = path / rel
        if left.is_file() and right.is_file():
            code, out, _ = run(["diff", "-u", str(left), str(right)])
            if out:
                chunks.append(out)
        elif right.is_file() and not left.is_file():
            chunks.append(new_file_diff(right))
        elif left.is_file() and not right.is_file():
            chunks.append(removed_file_diff(left, rel))
        else:
            chunks.append(f"--- {rel} (presence changed)\n")
    return clip_diff("\n".join(chunks))


def slug_for(files: list[str]) -> str:
    stems = []
    for f in files:
        if f == "manifest.json":
            continue
        stem = Path(f).name
        stem = re.sub(r"[^a-z0-9]+", "-", stem.lower()).strip("-")
        if stem:
            stems.append(stem)
    stems = stems[:2]
    if not stems:
        return "local-edits"
    return "-and-".join(stems)[:60]


def summarize_files(files: list[str]) -> str:
    shown = [f for f in files if f != "manifest.json"] or files
    if not shown:
        return "local edits"
    if len(shown) == 1:
        return f"local edits to {shown[0]}"
    if len(shown) == 2:
        return f"local edits to {shown[0]} and {shown[1]}"
    return f"local edits to {shown[0]}, {shown[1]}, and {len(shown) - 2} more"


def write_record(
    plugin_id: str,
    files: list[str],
    commit: str,
    diff: str,
    plugin_path: Path | None = None,
    source_fp: str = "",
    title_prefix="Local edits",
):
    RECORDS_DIR.mkdir(parents=True, exist_ok=True)
    plugin_dir = RECORDS_DIR / plugin_id
    plugin_dir.mkdir(parents=True, exist_ok=True)
    slug = slug_for(files)
    path = plugin_dir / f"{slug}.md"
    n = 2
    while path.exists():
        path = plugin_dir / f"{slug}-{n}.md"
        n += 1
    title = summarize_files(files)
    title = title[0].upper() + title[1:] if title else title_prefix
    file_lines = "\n".join(f"  - {f}" for f in files) or "  - ."
    diff = diff.strip() or "(no textual diff)"
    tree = tree_hash(plugin_path, files) if plugin_path else ""
    version = plugin_manifest(plugin_path)["version"] if plugin_path else ""
    applied_lines = [f"  commit: {commit}", f"  at: {now_iso()}"]
    if version:
        applied_lines.append(f"  version: {version}")
    if tree:
        applied_lines.append(f"  tree: {tree}")
    if source_fp:
        applied_lines.append(f"  source: {source_fp}")
    body = f"""---
id: {path.stem}
plugin: {plugin_id}
title: {title}
bootstrapped: true
enabled: false
applied:
{chr(10).join(applied_lines)}
files:
{file_lines}
---

# {title}

## Goal

Draft — refine with the plugin-maleability skill.

Mechanical summary: {summarize_files(files)}.

## Why / decisions

Unknown. Captured automatically when Plugin Maleability was
installed, because this checkout differed from upstream.

## Where to look

{chr(10).join(f'- `{f}`' for f in files)}

## Prior art

Captured against{f" version {version}" if version else ""} `{commit}`. This is an example of the current local tree,
not a patch to apply blindly.

```diff
{diff}
```

## Re-apply notes

Draft. Expand Goal and Why before the next upstream update.
"""
    path.write_text(body)
    return path


def sha_match(head: str, applied: str) -> bool:
    if not head or not applied:
        return False
    if applied == "cloned":
        return head == "cloned"
    return head.startswith(applied) or applied.startswith(head[: min(len(applied), 7)])


def is_placeholder_draft(rec: dict) -> bool:
    return bool(rec.get("bootstrapped") and rec.get("draftGoal"))


def customization_status(rec, head: str, source_fp: str = "", current_tree: str = "") -> str:
    if is_placeholder_draft(rec):
        return "draft"
    if not rec.get("enabled", True):
        return "unapplied"
    if rec.get("appliedSource") and source_fp and rec["appliedSource"] != source_fp:
        return "stale"
    commit = rec.get("appliedCommit") or ""
    if commit and commit != "cloned" and head and not sha_match(head, commit):
        return "stale"
    if rec.get("appliedTree") and current_tree and rec["appliedTree"] != current_tree:
        return "drift"
    return "applied"


def set_record_enabled(path: Path, enabled: bool) -> None:
    text = path.read_text(errors="replace")
    fm, body = parse_frontmatter(text)
    if not fm and not text.startswith("---"):
        return
    rest = text[3:].lstrip("\n")
    end = rest.find("\n---")
    if end < 0:
        return
    block = rest[:end]
    value = "true" if enabled else "false"
    if re.search(r"^enabled:\s*", block, re.M):
        block = re.sub(r"^enabled:\s*.*$", f"enabled: {value}", block, count=1, flags=re.M)
    else:
        block = f"enabled: {value}\n" + block
    path.write_text("---\n" + block.strip() + "\n---" + body)


def set_applied_field(path: Path, key: str, value: str) -> None:
    text = path.read_text(errors="replace")
    if not text.startswith("---"):
        return
    rest = text[3:].lstrip("\n")
    end = rest.find("\n---")
    if end < 0:
        return
    block = rest[:end]
    body = rest[end + 4 :]
    nested = re.compile(rf"^  {re.escape(key)}:\s*.*$", re.M)
    if nested.search(block):
        block = nested.sub(f"  {key}: {value}", block, count=1)
    elif re.search(r"^applied:\s*$", block, re.M):
        block = re.sub(
            r"^applied:\s*$",
            f"applied:\n  {key}: {value}",
            block,
            count=1,
            flags=re.M,
        )
    else:
        block = block.rstrip() + f"\napplied:\n  {key}: {value}\n"
    path.write_text("---\n" + block.strip() + "\n---" + body)


def mark_plugin_records(plugin_id: str, enabled: bool) -> int:
    n = 0
    for rec in load_records().get(plugin_id, []):
        set_record_enabled(Path(rec["path"]), enabled)
        n += 1
    return n


def find_plugin_dir(plugin_id: str) -> Path | None:
    if "/" in plugin_id or ".." in plugin_id:
        return None
    direct = PLUGINS_DIR / plugin_id
    if direct.is_dir():
        return direct
    if not PLUGINS_DIR.is_dir():
        return None
    for path in PLUGINS_DIR.iterdir():
        if not path.is_dir() or path.name.startswith("."):
            continue
        if plugin_manifest(path)["id"] == plugin_id:
            return path
    return None


def list_untracked_for_clean(path: Path, catalog) -> list[str]:
    if (path / ".git").exists():
        return git_untracked_files(path)
    meta = plugin_manifest(path)
    source = catalog.get(meta.get("clonedFrom") or "")
    if not source or not source.is_dir():
        return []
    wanted = set()
    for src in source.rglob("*"):
        if src.is_file():
            rel = src.relative_to(source).as_posix()
            if rel != "manifest.json":
                wanted.add(rel)
    extra = []
    for dest in path.rglob("*"):
        if not dest.is_file():
            continue
        rel = dest.relative_to(path).as_posix()
        if rel in ("manifest.json",) or rel.startswith(".git/"):
            continue
        if rel not in wanted:
            extra.append(rel)
    return extra


def reset_checkout(path: Path, catalog) -> tuple[str, list[str]]:
    cleaned = list_untracked_for_clean(path, catalog)
    if (path / ".git").exists():
        code, _, err = git(path, "reset", "--hard", "HEAD")
        if code != 0:
            return err or "git reset failed", []
        git(path, "clean", "-fd", "-e", ".git")
        return "", cleaned
    meta = plugin_manifest(path)
    source = catalog.get(meta.get("clonedFrom") or "")
    if not source or not source.is_dir():
        return "not a git checkout and no clone source", []
    wanted = set()
    for src in source.rglob("*"):
        if not src.is_file():
            continue
        rel = src.relative_to(source)
        if rel.as_posix() == "manifest.json":
            continue
        wanted.add(rel.as_posix())
        dest = path / rel
        dest.parent.mkdir(parents=True, exist_ok=True)
        dest.write_bytes(src.read_bytes())
    for dest in path.rglob("*"):
        if not dest.is_file():
            continue
        rel = dest.relative_to(path).as_posix()
        if rel in ("manifest.json",) or rel.startswith(".git/"):
            continue
        if rel not in wanted:
            dest.unlink()
    return "", cleaned


def delete_customization(plugin_id: str, customization_id: str, catalog) -> tuple[str, list[str], list[str]]:
    recs = load_records().get(plugin_id, [])
    rec = next((r for r in recs if r["id"] == customization_id), None)
    if not rec:
        return f"customization not found: {customization_id}", [], []
    remaining_enabled = [
        r["id"]
        for r in recs
        if r["id"] != customization_id
        and r.get("enabled", True)
        and not is_placeholder_draft(r)
    ]
    path = Path(rec["path"])
    destructive = rec.get("enabled", True) and not is_placeholder_draft(rec)
    if not destructive:
        if path.is_file():
            path.unlink()
        return "", [], []
    plugin_dir = find_plugin_dir(plugin_id)
    if not plugin_dir:
        return f"plugin not found: {plugin_id}", [], []
    err, cleaned = reset_checkout(plugin_dir, catalog)
    if err:
        return err, [], []
    if path.is_file():
        path.unlink()
    mark_plugin_records(plugin_id, False)
    return "", remaining_enabled, cleaned


def update_checkout(path: Path, catalog) -> tuple[str, list[str]]:
    if not (path / ".git").exists():
        return reset_checkout(path, catalog)
    pre = git_head(path)
    cleaned = list_untracked_for_clean(path, catalog)
    code, _, err = git(path, "fetch", "--quiet", "origin", timeout=60)
    if code != 0:
        return err or "git fetch failed", []
    code, _, err = git(path, "reset", "--hard", "FETCH_HEAD")
    if code != 0:
        return err or "git reset failed", []
    git(path, "clean", "-fd", "-e", ".git")
    vcode, _, verr = run(["omarchy-plugin-validate", str(path)], timeout=30)
    if vcode != 0:
        if pre:
            git(path, "reset", "--hard", pre)
            git(path, "clean", "-fd", "-e", ".git")
        return (verr or "plugin validate failed after update").strip() or "plugin validate failed after update", []
    return "", cleaned


def short(sha: str) -> str:
    return sha[:7] if sha else ""


def backfill_applied(rec: dict, plugin_path: Path, source_fp: str) -> None:
    path = Path(rec["path"])
    if rec["files"] and plugin_path.is_dir() and not rec.get("appliedTree"):
        tree = tree_hash(plugin_path, rec["files"])
        set_applied_field(path, "tree", tree)
        rec["appliedTree"] = tree
    if source_fp and not rec.get("appliedSource"):
        set_applied_field(path, "source", source_fp)
        rec["appliedSource"] = source_fp


def scan_plugin(path: Path, records, catalog, fetch: bool) -> dict | None:
    if not path.is_dir() or path.name.startswith("."):
        return None
    meta = plugin_manifest(path)
    pid = meta["id"]
    if pid == SELF_ID or path.name == SELF_ID:
        return None
    kind = "plain"
    head = ""
    origin = ""
    dirty = []
    ahead = False
    behind = False
    bootstrap_diff = ""
    source_fp = ""
    is_git = (path / ".git").exists()
    if is_git:
        kind = "git"
        if fetch:
            git(path, "fetch", "--quiet", "origin", timeout=30)
        head = git_head(path)
        origin = git_origin(path)
        dirty = git_dirty_files(path)
        if origin and head:
            code, behind_count, _ = git(path, "rev-list", "--count", f"{head}..{origin}")
            code2, ahead_count, _ = git(path, "rev-list", "--count", f"{origin}..{head}")
            try:
                behind = code == 0 and int(behind_count or "0") > 0
                ahead = code2 == 0 and int(ahead_count or "0") > 0
            except ValueError:
                behind = origin != head
        if dirty:
            bootstrap_diff = git_diff_text(path)
        elif ahead:
            bootstrap_diff = git_ahead_diff(path, origin)
            code, out, _ = git(path, "diff", "--name-only", f"{origin}...HEAD")
            if code == 0:
                dirty = [line for line in out.splitlines() if line]
    elif meta["clonedFrom"]:
        kind = "clone"
        source = catalog.get(meta["clonedFrom"])
        if source:
            source_fp = source_fingerprint(source)
            dirty = clone_diff_files(path, source)
            meaningful = [f for f in dirty if f != "manifest.json"]
            if not meaningful:
                dirty = []
            else:
                bootstrap_diff = clone_diff_text(path, source, dirty)
                head = "cloned"

    recs = records.get(pid, [])
    customizations = []
    recorded_files = set()
    clone_stale = False
    for rec in recs:
        backfill_applied(rec, path, source_fp)
        current_tree = tree_hash(path, rec["files"]) if rec["files"] else ""
        status = customization_status(rec, head, source_fp, current_tree)
        if status == "stale" and kind == "clone" and rec.get("enabled", True) and not is_placeholder_draft(rec):
            clone_stale = True
        recorded_files.update(rec["files"])
        customizations.append(
            {
                "id": rec["id"],
                "title": rec["title"],
                "status": status,
                "enabled": rec.get("enabled", True),
                "path": rec["path"],
                "appliedCommit": rec["appliedCommit"],
                "appliedVersion": rec.get("appliedVersion") or "",
                "bootstrapped": rec["bootstrapped"],
                "files": rec["files"],
                "goal": rec["goal"],
                "why": rec["why"],
            }
        )
    if kind == "clone" and clone_stale:
        behind = True
    unrecorded = [f for f in dirty if f not in recorded_files]
    return {
        "id": pid,
        "name": meta["name"],
        "version": meta.get("version") or "",
        "kind": kind,
        "path": str(path),
        "head": head,
        "origin": origin,
        "ahead": ahead,
        "behind": behind,
        "dirty": dirty,
        "unrecordedFiles": unrecorded,
        "sourceFingerprint": source_fp,
        "customizations": customizations,
        "_bootstrap_diff": bootstrap_diff,
    }


def needs_bootstrap(plugin: dict) -> bool:
    if plugin["customizations"]:
        return bool(plugin["unrecordedFiles"])
    return bool(plugin["dirty"]) or plugin["ahead"]


def bootstrap(plugins: list[dict]):
    written = []
    for plugin in plugins:
        if not needs_bootstrap(plugin):
            continue
        files = plugin["unrecordedFiles"] or plugin["dirty"]
        if not files:
            continue
        commit = short(plugin["head"]) or plugin["head"] or "cloned"
        path = write_record(
            plugin["id"],
            files,
            commit,
            plugin.get("_bootstrap_diff") or "",
            plugin_path=Path(plugin["path"]),
            source_fp=plugin.get("sourceFingerprint") or "",
        )
        written.append(str(path))
    return written


def assemble(plugins: list[dict]) -> dict:
    counts = {
        "stale": 0,
        "draft": 0,
        "unrecorded": 0,
        "updateAvailable": 0,
        "applied": 0,
        "unapplied": 0,
        "drift": 0,
    }
    out_plugins = []
    for plugin in plugins:
        statuses = [c["status"] for c in plugin["customizations"]]
        if plugin["unrecordedFiles"] and "unrecorded" not in statuses:
            counts["unrecorded"] += 1
        for status in statuses:
            if status in counts:
                counts[status] += 1
        if plugin.get("behind"):
            counts["updateAvailable"] += 1
        public = {k: v for k, v in plugin.items() if not k.startswith("_")}
        out_plugins.append(public)
    attention = any(
        counts[k] > 0
        for k in ("stale", "draft", "unrecorded", "updateAvailable", "drift")
    )
    return {
        "ok": True,
        "attention": attention,
        "selfId": SELF_ID,
        "recordsDir": str(RECORDS_DIR),
        "counts": counts,
        "plugins": out_plugins,
    }


def notify_if_needed(payload: dict):
    prev = ""
    if NOTIFY_STATE.is_file():
        prev = NOTIFY_STATE.read_text().strip()
    current = "1" if payload["attention"] else "0"
    RECORDS_DIR.mkdir(parents=True, exist_ok=True)
    NOTIFY_STATE.write_text(current + "\n")
    if current != "1" or prev == "1":
        return
    counts = payload["counts"]
    bits = []
    if counts["stale"]:
        bits.append(f"{counts['stale']} to re-apply")
    if counts.get("drift"):
        bits.append(f"{counts['drift']} drift")
    if counts["draft"]:
        bits.append(f"{counts['draft']} draft")
    if counts["unrecorded"]:
        bits.append(f"{counts['unrecorded']} unrecorded")
    if counts["updateAvailable"]:
        bits.append(f"{counts['updateAvailable']} updates")
    detail = ", ".join(bits) if bits else "Open the panel for details."
    run(
        [
            "omarchy-notification-send",
            "-g",
            "󰠱",
            "-u",
            "normal",
            "--app-name",
            "Plugin Maleability",
            "Plugin Maleability needs attention",
            detail + ". Open the panel to view or apply each one.",
            "--exec",
            "omarchy-shell",
            "djschnei21.plugin-maleability",
            "show",
        ]
    )


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--bootstrap", action="store_true")
    parser.add_argument("--fetch", action="store_true")
    parser.add_argument("--notify", action="store_true")
    parser.add_argument("--reset", metavar="PLUGIN_ID")
    parser.add_argument("--update", metavar="PLUGIN_ID")
    parser.add_argument("--delete", nargs=2, metavar=("PLUGIN_ID", "CUSTOMIZATION_ID"))
    args = parser.parse_args()

    with records_lock():
        catalog = catalog_source_dirs()

        reapply_ids = []
        cleaned = []
        if args.delete:
            err, reapply_ids, cleaned = delete_customization(
                args.delete[0], args.delete[1], catalog
            )
            if err:
                return fail_payload(
                    err,
                    plugin=args.delete[0],
                    customization=args.delete[1],
                )

        if args.reset or args.update:
            plugin_id = args.reset or args.update
            path = find_plugin_dir(plugin_id)
            if not path:
                return fail_payload(f"plugin not found: {plugin_id}", plugin=plugin_id)
            if args.update:
                err, cleaned = update_checkout(path, catalog)
            else:
                err, cleaned = reset_checkout(path, catalog)
            if err:
                return fail_payload(err, plugin=plugin_id)
            mark_plugin_records(plugin_id, False)

        records = load_records()
        plugins = []
        if PLUGINS_DIR.is_dir():
            for path in sorted(PLUGINS_DIR.iterdir()):
                scanned = scan_plugin(path, records, catalog, fetch=args.fetch)
                if scanned:
                    plugins.append(scanned)

        if args.bootstrap:
            bootstrap(plugins)
            records = load_records()
            plugins = []
            if PLUGINS_DIR.is_dir():
                for path in sorted(PLUGINS_DIR.iterdir()):
                    scanned = scan_plugin(path, records, catalog, fetch=False)
                    if scanned:
                        plugins.append(scanned)

        payload = assemble(plugins)
        if reapply_ids:
            payload["reapplyIds"] = reapply_ids
        if cleaned:
            payload["cleaned"] = cleaned
        if args.notify:
            notify_if_needed(payload)
        json.dump(payload, sys.stdout, indent=2)
        sys.stdout.write("\n")
        return 0


if __name__ == "__main__":
    sys.exit(main())
