#!/usr/bin/env bash
# Link this plugin's skill (SKILL.md + references) into every Omarchy agent
# skill dir, then bootstrap records.
set -euo pipefail

PLUGIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
STATUS="$PLUGIN_DIR/status"

skill_dirs=(
  "$HOME/.agents/skills"
  "$HOME/.claude/skills"
  "$HOME/.codex/skills"
  "$HOME/.pi/agent/skills"
  "$HOME/.grok/skills"
)

for dir in "${skill_dirs[@]}"; do
  mkdir -p "$dir"
  # Previous versions symlinked the whole plugin tree as this skill name.
  if [[ -L $dir/plugin-maleability ]]; then
    rm -f "$dir/plugin-maleability"
  fi
  mkdir -p "$dir/plugin-maleability"
  ln -sfn "$PLUGIN_DIR/SKILL.md" "$dir/plugin-maleability/SKILL.md"
  ln -sfn "$PLUGIN_DIR/references" "$dir/plugin-maleability/references"
  if [[ -L $dir/plugin-customizations ]]; then
    old=$(readlink -f "$dir/plugin-customizations" || true)
    if [[ $old == "$(readlink -f "$PLUGIN_DIR")" ]]; then
      rm -f "$dir/plugin-customizations"
    fi
  fi
done

exec python3 "$STATUS" --bootstrap "$@"
